{"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"abstract":[{"text":"How to install and initialize EUDI Wallet Kit in your project","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eudiwalletkit\/getstarted"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Package installation","type":"heading","anchor":"Package-installation"},{"inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"inlineContent":[{"type":"text","text":"Then add the Eudi Wallet package to your target’s dependencies:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"level":2,"text":"Initialization","type":"heading","anchor":"Initialization"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet"},{"type":"text","text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an "},{"type":"codeVoice","code":"environmentObject"},{"type":"text","text":" to be accessible from all views. A KeyChain implementation of document storage is available."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"]},{"level":3,"text":"Transaction logging","type":"heading","anchor":"Transaction-logging"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"codeVoice","code":"TransactionLogger.log(transaction:)"},{"type":"text","text":" with "},{"type":"codeVoice","code":"TransactionEntry"},{"type":"text","text":". Persist entries by"},{"type":"text","text":" "},{"type":"codeVoice","code":"transactionIdentifier"},{"type":"text","text":": subsequent calls update the same transaction. A request is saved with"},{"type":"text","text":" "},{"type":"codeVoice","code":"transactionResult == .notCompleted"},{"type":"text","text":" before credential selection, and updated after successful"},{"type":"text","text":" "},{"type":"text","text":"response delivery. Cancellation, failures, and interrupted sessions remain "},{"type":"codeVoice","code":"NotCompleted"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"reasonOfNoncompletion"},{"type":"text","text":" records a known reason."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Presentation "},{"type":"codeVoice","code":"listOfClaimsRequested"},{"type":"text","text":" includes the union of every DCQL credential\/claim alternative,"},{"type":"text","text":" "},{"type":"text","text":"including unavailable credential types and all "},{"type":"codeVoice","code":"vct_values"},{"type":"text","text":". When claims are omitted, known paths"},{"type":"text","text":" "},{"type":"text","text":"from all matching wallet credentials are included. "},{"type":"codeVoice","code":"listOfClaimsPresented"},{"type":"text","text":" contains the disclosed"},{"type":"text","text":" "},{"type":"text","text":"claim paths. Entries do not store claim values."}],"type":"paragraph"},{"level":3,"text":"BLE Transfer Mode","type":"heading","anchor":"BLE-Transfer-Mode"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode"},{"type":"text","text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation."},{"type":"text","text":" "},{"type":"text","text":"You can set it during initialization via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode"},{"type":"text","text":" or update it later on the wallet instance:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".server"}],"type":"strong"},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".client"}],"type":"strong"},{"text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".both"}],"type":"strong"},{"text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement.","type":"text"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"]},{"level":3,"text":"BLE Transport Factory","type":"heading","anchor":"BLE-Transport-Factory"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory"},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A transport factory conforms to the "},{"type":"codeVoice","code":"BleTransportFactory"},{"type":"text","text":" protocol and provides "},{"type":"codeVoice","code":"createServer()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"createClient()"},{"type":"text","text":" methods that each return an "},{"type":"codeVoice","code":"MdocBleTransport"},{"type":"text","text":" instance. When "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (the default), "},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"type":"text","text":" is used, which creates the standard GATT server\/central transports."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"level":3,"text":"OpenID4VCI Configuration","type":"heading","anchor":"OpenID4VCI-Configuration"},{"inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"issuerMetadataPolicy"},{"type":"text","text":" to control signed metadata handling per issuer:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".requireSigned","type":"codeVoice"},{"text":" for issuers that require signed metadata validation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".ignoreSigned","type":"codeVoice"},{"text":" for environments that still use unsigned metadata","type":"text"}]}]}]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"EudiWalletKit"}],"title":"Get started"},"sections":[],"identifier":{"url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/TrustMark","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"anchor":"Essentials"}],"kind":"article","references":{"doc://EudiWalletKit/documentation/EudiWalletKit/WalletUI":{"kind":"article","abstract":[],"title":"EUDI iOS Wallet reference implementation","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI","role":"sampleCode","type":"topic","url":"\/documentation\/eudiwalletkit\/walletui"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWalletConfiguration/bleTransferMode":{"type":"topic","url":"\/documentation\/eudiwalletkit\/eudiwalletconfiguration\/bletransfermode","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","title":"bleTransferMode","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bleTransferMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO","kind":"typeIdentifier","text":"BleTransferMode"}],"abstract":[{"type":"text","text":"BLE transfer mode for proximity presentation. Controls the role the device plays during BLE data transfer."}]},"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"type":"topic","url":"\/documentation\/eudiwalletkit\/secureareas","kind":"article","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","title":"Custom key management","role":"article","abstract":[{"type":"text","text":"Eudi Wallet Kit supports custom key management through the implementation of SecureArea and SecureKeyStorage protocols. This document details the process of integrating custom key management with the library."}]},"doc://EudiWalletKit/documentation/EudiWalletKit/ManageDocuments":{"abstract":[{"text":"The EudiWallet class provides a set of methods to work with documents.","type":"text"}],"url":"\/documentation\/eudiwalletkit\/managedocuments","title":"Manage documents","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","role":"article","type":"topic","kind":"article"},"doc://EudiWalletKit/documentation/EudiWalletKit/RegistrationCertificate":{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","type":"topic","url":"\/documentation\/eudiwalletkit\/registrationcertificate","role":"collectionGroup","abstract":[{"type":"text","text":"Validate the Wallet-Relying Party Registration Certificate (WRPRC) that a relying party presents with a data-sharing request, or that a credential issuer publishes with its metadata."}],"title":"Registration Certificate","kind":"article"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransferMode":{"abstract":[{"type":"text","text":"Ble transfer mode"}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bleTransferMode"},{"kind":"text","text":": "},{"preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO","kind":"typeIdentifier","text":"BleTransferMode"}],"title":"bleTransferMode","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","role":"symbol","kind":"symbol","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransfermode"},"doc://EudiWalletKit/documentation/EudiWalletKit":{"type":"topic","url":"\/documentation\/eudiwalletkit","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit","title":"EudiWalletKit","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"EUDI Wallet Kit library for iOS"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransportFactory":{"type":"topic","title":"bleTransportFactory","kind":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransportfactory","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bleTransportFactory","kind":"identifier"},{"text":": (","kind":"text"},{"text":"any","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BleTransportFactory","preciseIdentifier":"s:21MdocDataTransfer1801319BleTransportFactoryP","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"abstract":[{"text":"Factory for creating BLE transport instances. When nil, default GATT transports are used.","type":"text"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/TrustMark":{"abstract":[{"text":"Configure and retrieve EUDI Wallet Trust Mark information and display resources.","type":"text"}],"url":"\/documentation\/eudiwalletkit\/trustmark","title":"Trust Mark","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/TrustMark","role":"article","type":"topic","kind":"article"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet":{"url":"\/documentation\/eudiwalletkit\/eudiwallet","title":"EudiWallet","kind":"symbol","type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EudiWallet"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EudiWallet"}],"abstract":[{"type":"text","text":"User wallet implementation"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/PresentationService":{"type":"topic","title":"PresentationService","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","url":"\/documentation\/eudiwalletkit\/presentationservice","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PresentationService"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresentationService"}],"abstract":[{"type":"text","text":"Presentation service abstract protocol"}]}}}