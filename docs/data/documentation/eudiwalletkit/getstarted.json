{"seeAlsoSections":[{"identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"kind":"article","identifier":{"url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Package installation","level":2,"anchor":"Package-installation","type":"heading"},{"inlineContent":[{"text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then add the Eudi Wallet package to your target’s dependencies:","type":"text"}],"type":"paragraph"},{"code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"],"syntax":"swift","type":"codeListing"},{"text":"Initialization","level":2,"anchor":"Initialization","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","type":"reference"},{"text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an ","type":"text"},{"code":"environmentObject","type":"codeVoice"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}],"type":"paragraph"},{"code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"],"syntax":"swift","type":"codeListing"},{"text":"BLE Transfer Mode","level":3,"anchor":"BLE-Transfer-Mode","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","type":"reference"},{"text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation.","type":"text"},{"text":" ","type":"text"},{"text":"You can set it during initialization via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","type":"reference"},{"text":" or update it later on the wallet instance:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".server","type":"codeVoice"}],"type":"strong"},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".client","type":"codeVoice"}],"type":"strong"},{"text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".both","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement."}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"],"type":"codeListing"},{"level":3,"type":"heading","text":"BLE Transport Factory","anchor":"BLE-Transport-Factory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","type":"reference"},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A transport factory conforms to the "},{"type":"codeVoice","code":"BleTransportFactory"},{"type":"text","text":" protocol and provides "},{"type":"codeVoice","code":"createServer()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"createClient()"},{"type":"text","text":" methods that each return an "},{"type":"codeVoice","code":"MdocBleTransport"},{"type":"text","text":" instance. When "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (the default), "},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"type":"text","text":" is used, which creates the standard GATT server\/central transports."}]},{"syntax":"swift","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"],"type":"codeListing"},{"level":3,"type":"heading","text":"OpenID4VCI Configuration","anchor":"OpenID4VCI-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}]},{"syntax":"swift","code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"issuerMetadataPolicy"},{"type":"text","text":" to control signed metadata handling per issuer:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".requireSigned"},{"type":"text","text":" for issuers that require signed metadata validation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".ignoreSigned"},{"type":"text","text":" for environments that still use unsigned metadata"}],"type":"paragraph"}]}]}]}],"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"How to install and initialize EUDI Wallet Kit in your project","type":"text"}],"metadata":{"role":"article","title":"Get started","modules":[{"name":"EudiWalletKit"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/RegistrationCertificate":{"url":"\/documentation\/eudiwalletkit\/registrationcertificate","abstract":[{"text":"Validate the Wallet-Relying Party Registration Certificate (WRPRC) that a relying party presents with a data-sharing request.","type":"text"}],"type":"topic","kind":"article","title":"Registration Certificate","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","role":"collectionGroup"},"doc://EudiWalletKit/documentation/EudiWalletKit/ManageDocuments":{"abstract":[{"text":"The EudiWallet class provides a set of methods to work with documents.","type":"text"}],"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","kind":"article","role":"article","type":"topic","title":"Manage documents","url":"\/documentation\/eudiwalletkit\/managedocuments"},"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"url":"\/documentation\/eudiwalletkit\/secureareas","abstract":[{"text":"Eudi Wallet Kit supports custom key management through the implementation of SecureArea and SecureKeyStorage protocols. This document details the process of integrating custom key management with the library.","type":"text"}],"type":"topic","kind":"article","title":"Custom key management","