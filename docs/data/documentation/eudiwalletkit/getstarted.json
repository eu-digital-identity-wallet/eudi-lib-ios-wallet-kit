{"primaryContentSections":[{"content":[{"level":2,"anchor":"Package-installation","type":"heading","text":"Package installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add the Eudi Wallet package to your target’s dependencies:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"level":2,"anchor":"Initialization","type":"heading","text":"Initialization"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","type":"reference"},{"text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an ","type":"text"},{"code":"environmentObject","type":"codeVoice"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"]},{"level":3,"anchor":"BLE-Transfer-Mode","type":"heading","text":"BLE Transfer Mode"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","isActive":true,"type":"reference"},{"text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation.","type":"text"},{"text":" ","type":"text"},{"text":"You can set it during initialization via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","type":"reference"},{"type":"text","text":" or update it later on the wallet instance:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".server","type":"codeVoice"}],"type":"strong"},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".client"}]},{"text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".both"}]},{"type":"text","text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"]},{"type":"heading","anchor":"BLE-Transport-Factory","level":3,"text":"BLE Transport Factory"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","type":"reference","isActive":true},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A transport factory conforms to the "},{"type":"codeVoice","code":"BleTransportFactory"},{"text":" protocol and provides ","type":"text"},{"type":"codeVoice","code":"createServer()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"createClient()"},{"text":" methods that each return an ","type":"text"},{"type":"codeVoice","code":"MdocBleTransport"},{"text":" instance. When ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" (the default), ","type":"text"},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"text":" is used, which creates the standard GATT server\/central transports.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"level":3,"text":"OpenID4VCI Configuration","anchor":"OpenID4VCI-Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}],"type":"paragraph"},{"code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"issuerMetadataPolicy"},{"text":" to control signed metadata handling per issuer:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".requireSigned"},{"type":"text","text":" for issuers that require signed metadata validation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".ignoreSigned","type":"codeVoice"},{"text":" for environments that still use unsigned metadata","type":"text"}]}]}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"How to install and initialize EUDI Wallet Kit in your project"}],"metadata":{"roleHeading":"Article","modules":[{"name":"EudiWalletKit"}],"role":"article","title":"Get started"},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"title":"Custom key management","type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","kind":"article","role":"article","url":"\/documentation\/eudiwalletkit\/secureareas","abstract":[{"type":"text","text":"Eudi Wallet Kit supports custom key management through the implementation of SecureArea and SecureKeyStorage protocols. This document details the process of integrating custom key management with the library."}]},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet":{"kind":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","abstract":[{"text":"User wallet implementation","type":"text"}],"url":"\/documentation\/eudiwalletkit\/eudiwallet","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EudiWallet","kind":"identifier"}],"title":"EudiWallet","type":"topic","navigatorTitle":[{"text":"EudiWallet","kind":"identifier"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/RegistrationCertificate":{"url":"\/documentation\/eudiwalletkit\/registrationcertificate","type":"topic","title":"Registration Certificate","kind":"article","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","abstract":[{"type":"text","text":"Validate the Wallet-Relying Party Registration Certificate (WRPRC) that a relying party presents with a data-sharing request, or that a credential issuer publishes with its metadata."}],"role":"collectionGroup"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWalletConfiguration/bleTransferMode":{"kind":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","url":"\/documentation\/eudiwalletkit\/eudiwalletconfiguration\/bletransfermode","abstract":[{"type":"text","text":"BLE transfer mode for proximity presentation. Controls the role the device plays during BLE data transfer."}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"bleTransferMode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO","text":"BleTransferMode"}],"title":"bleTransferMode","type":"topic"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransferMode":{"title":"bleTransferMode","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransfermode","abstract":[{"type":"text","text":"Ble transfer mode"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bleTransferMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BleTransferMode","preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO","kind":"typeIdentifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://EudiWalletKit/documentation/EudiWalletKit":{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit","title":"EudiWalletKit","url":"\/documentation\/eudiwalletkit","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"EUDI Wallet Kit library for iOS"}],"type":"topic"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransportFactory":{"title":"bleTransportFactory","type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bleTransportFactory"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"BleTransportFactory","preciseIdentifier":"s:21MdocDataTransfer1801319BleTransportFactoryP"},{"kind":"text","text":")?"}],"kind":"symbol","role":"symbol","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransportfactory","abstract":[{"text":"Factory for creating BLE transport instances. When nil, default GATT transports are used.","type":"text"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/ManageDocuments":{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","kind":"article","abstract":[{"type":"text","text":"The EudiWallet class provides a set of methods to work with documents."}],"url":"\/documentation\/eudiwalletkit\/managedocuments","role":"article","title":"Manage documents","type":"topic"},"doc://EudiWalletKit/documentation/EudiWalletKit/WalletUI":{"title":"EUDI iOS Wallet reference implementation","type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI","kind":"article","role":"sampleCode","url":"\/documentation\/eudiwalletkit\/walletui","abstract":[]},"doc://EudiWalletKit/documentation/EudiWalletKit/PresentationService":{"url":"\/documentation\/eudiwalletkit\/presentationservice","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","title":"PresentationService","abstract":[{"type":"text","text":"Presentation service abstract protocol"}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"PresentationService","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"PresentationService","kind":"identifier"}],"role":"symbol","type"