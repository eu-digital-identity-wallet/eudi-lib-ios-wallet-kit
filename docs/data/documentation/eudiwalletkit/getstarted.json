{"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"generated":true}],"metadata":{"modules":[{"name":"EudiWalletKit"}],"roleHeading":"Article","title":"Get started","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Package installation","anchor":"Package-installation","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"type":"paragraph","inlineContent":[{"text":"Then add the Eudi Wallet package to your target’s dependencies:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"type":"heading","level":2,"text":"Initialization","anchor":"Initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet"},{"text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an ","type":"text"},{"type":"codeVoice","code":"environmentObject"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}]},{"code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"BLE Transfer Mode","anchor":"BLE-Transfer-Mode"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","isActive":true,"type":"reference"},{"text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation.","type":"text"},{"text":" ","type":"text"},{"text":"You can set it during initialization via ","type":"text"},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","isActive":true,"type":"reference"},{"text":" or update it later on the wallet instance:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".server"}],"type":"strong"},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".client","type":"codeVoice"}]},{"type":"text","text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".both","type":"codeVoice"}]},{"type":"text","text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement."}],"type":"paragraph"}]}]},{"code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"BLE-Transport-Factory","text":"BLE Transport Factory","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","isActive":true},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A transport factory conforms to the "},{"code":"BleTransportFactory","type":"codeVoice"},{"type":"text","text":" protocol and provides "},{"code":"createServer()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"createClient()","type":"codeVoice"},{"type":"text","text":" methods that each return an "},{"code":"MdocBleTransport","type":"codeVoice"},{"type":"text","text":" instance. When "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" (the default), "},{"code":"DefaultBleTransportFactory","type":"codeVoice"},{"type":"text","text":" is used, which creates the standard GATT server\/central transports."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"level":3,"anchor":"OpenID4VCI-Configuration","type":"heading","text":"OpenID4VCI Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}]},{"code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"issuerMetadataPolicy","type":"codeVoice"},{"type":"text","text":" to control signed metadata handling per issuer:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".requireSigned"},{"type":"text","text":" for issuers that require signed metadata validation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".ignoreSigned"},{"type":"text","text":" for environments that still use unsigned metadata"}]}]}]}]}],"kind":"article","identifier":{"url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"How to install and initialize EUDI Wallet Kit in your project"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/eudiwalletkit\/getstarted"]}],"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransportFactory":{"url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransportfactory","title":"bleTransportFactory","kind":"symbol","role":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"bleTransportFactory"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:21MdocDataTransfer1801319BleTransportFactoryP","text":"BleTransportFactory"},{"kind":"text","text":")?"}],"abstract":[{"type":"text","text":"Factory for creating BLE transport instances. When nil, default GATT transports are used."}]},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransferMode":{"type":"topic","abstract":[{"text":"Ble transfer mode","type":"text"}],"title":"bleTransferMode","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bleTransferMode","kind":"identifier"},{"text":": ","kind":"text"},{"text":"BleTransferMode","kind":"typeIdentifier","preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO"}],"k