{"identifier":{"url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"EudiWalletKit"}],"roleHeading":"Article","role":"article","title":"Get started"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Package installation","anchor":"Package-installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add the Eudi Wallet package to your target’s dependencies:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"level":2,"type":"heading","text":"Initialization","anchor":"Initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet"},{"type":"text","text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an "},{"type":"codeVoice","code":"environmentObject"},{"type":"text","text":" to be accessible from all views. A KeyChain implementation of document storage is available."}]},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"]},{"level":3,"type":"heading","text":"BLE Transfer Mode","anchor":"BLE-Transfer-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode"},{"type":"text","text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation."},{"type":"text","text":" "},{"type":"text","text":"You can set it during initialization via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode"},{"type":"text","text":" or update it later on the wallet instance:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".server"}],"type":"strong"},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".client"}],"type":"strong"},{"text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".both"}],"type":"strong"},{"text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"]},{"level":3,"type":"heading","text":"BLE Transport Factory","anchor":"BLE-Transport-Factory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory"},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A transport factory conforms to the "},{"type":"codeVoice","code":"BleTransportFactory"},{"type":"text","text":" protocol and provides "},{"type":"codeVoice","code":"createServer()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"createClient()"},{"type":"text","text":" methods that each return an "},{"type":"codeVoice","code":"MdocBleTransport"},{"type":"text","text":" instance. When "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (the default), "},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"type":"text","text":" is used, which creates the standard GATT server\/central transports."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"level":3,"type":"heading","text":"OpenID4VCI Configuration","anchor":"OpenID4VCI-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"issuerMetadataPolicy"},{"type":"text","text":" to control signed metadata handling per issuer:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".requireSigned","type":"codeVoice"},{"text":" for issuers that require signed metadata validation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".ignoreSigned","type":"codeVoice"},{"text":" for environments that still use unsigned metadata","type":"text"}],"type":"paragraph"}]}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"]}],"abstract":[{"text":"How to install and initialize EUDI Wallet Kit in your project","type":"text"}],"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/WalletUI":{"type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI","url":"\/documentation\/eudiwalletkit\/walletui","kind":"article","abstract":[],"title":"EUDI iOS Wallet reference implementation","role":"sampleCode"},"doc://EudiWalletKit/documentation/EudiWalletKit/ManageDocuments":{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","type":"topic","url":"\/documentation\/eudiwalletkit\/managedocuments","kind":"article","role":"article","title":"Manage documents","abstract":[{"type":"text","text":"The EudiWallet class provides a set of methods to work with documents."}]},"doc://EudiWalletKit/documentation/EudiWalletKit":{"title":"EudiWalletKit","url":"\/documentation\/eudiwalletkit","role":"collection","kind":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit","type":"topic","abstract":[{"text":"EUDI Wallet Kit library for iOS","type":"text"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","url":"\/documentation\/eudiwalletkit\/secureareas","kind":"article","abstract":[{"text":"Eudi Wallet Kit supports custom key management through the i