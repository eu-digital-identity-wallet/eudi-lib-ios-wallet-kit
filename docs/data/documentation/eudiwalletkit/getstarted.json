{"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","role":"article","title":"Get started","modules":[{"name":"EudiWalletKit"}]},"identifier":{"url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"abstract":[{"text":"How to install and initialize EUDI Wallet Kit in your project","type":"text"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/IssueDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/TrustMark","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"generated":true,"anchor":"Essentials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Package installation","anchor":"Package-installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"type":"paragraph","inlineContent":[{"text":"Then add the Eudi Wallet package to your target’s dependencies:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"type":"heading","level":2,"text":"Initialization","anchor":"Initialization"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet"},{"type":"text","text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an "},{"type":"codeVoice","code":"environmentObject"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"]},{"type":"heading","level":3,"text":"Device signature algorithm","anchor":"Device-signature-algorithm"},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/deviceAlgorithm","type":"reference"},{"type":"text","text":" to select the COSE algorithm for mdoc device signatures in BLE and OpenID4VP presentations. It defaults to "},{"code":".es256","type":"codeVoice"},{"text":"; use ","type":"text"},{"code":".esp256","type":"codeVoice"},{"text":" for fully specified P-256 signatures. Device MAC authentication ignores this setting.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let config = EudiWalletConfiguration(deviceAlgorithm: .esp256)"]},{"type":"heading","level":3,"text":"Transaction logging","anchor":"Transaction-logging"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"type":"codeVoice","code":"TransactionLogger.log(transaction:)"},{"type":"text","text":" with "},{"type":"codeVoice","code":"TransactionEntry"},{"type":"text","text":". Persist entries by"},{"type":"text","text":" "},{"type":"codeVoice","code":"transactionIdentifier"},{"type":"text","text":": subsequent calls update the same transaction. A request is saved with"},{"type":"text","text":" "},{"type":"codeVoice","code":"transactionResult == .notCompleted"},{"type":"text","text":" before credential selection, and updated after successful"},{"text":" ","type":"text"},{"text":"response delivery. Cancellation, failures, and interrupted sessions remain ","type":"text"},{"code":"NotCompleted","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"reasonOfNoncompletion"},{"type":"text","text":" records a known reason."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Presentation "},{"type":"codeVoice","code":"listOfClaimsRequested"},{"type":"text","text":" includes the union of every DCQL credential\/claim alternative,"},{"type":"text","text":" "},{"type":"text","text":"including unavailable credential types and all "},{"type":"codeVoice","code":"vct_values"},{"type":"text","text":". When claims are omitted, known paths"},{"type":"text","text":" "},{"type":"text","text":"from all matching wallet credentials are included. "},{"type":"codeVoice","code":"listOfClaimsPresented"},{"text":" contains the disclosed","type":"text"},{"text":" ","type":"text"},{"text":"claim paths. Entries do not store claim values.","type":"text"}]},{"type":"heading","level":3,"text":"BLE Transfer Mode","anchor":"BLE-Transfer-Mode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode"},{"type":"text","text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation."},{"type":"text","text":" "},{"type":"text","text":"You can set it during initialization via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode"},{"type":"text","text":" or update it later on the wallet instance:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".server","type":"codeVoice"}]},{"text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".client"}]},{"type":"text","text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".both","type":"codeVoice"}]},{"text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"]},{"anchor":"BLE-Transport-Factory","type":"heading","level":3,"text":"BLE Transport Factory"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory"},{"text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A transport factory conforms to the ","type":"text"},{"type":"codeVoice","code":"BleTransportFactory"},{"type":"text","text":" protocol and provides "},{"type":"codeVoice","code":"createServer()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"createClient()"},{"text":" methods that each return an ","type":"text"},{"type":"codeVoice","code":"MdocBleTransport"},{"text":" instance. When ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" (the default), ","type":"text"},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"text":" is used, which creates the standard GATT server\/central transports.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"],"type":"codeListing","syntax":"swift"},{"anchor":"OpenID4VCI-Configuration","text":"OpenID4VCI Configuration","level":3,"type":"heading"},{"inlineContent":[{"text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"issuerMetadataPolicy","type":"codeVoice"},{"text":" to control signed metadata handling per issuer:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".requireSigned"},{"text":" for issuers that require signed metadata validation","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".ignoreSigned"},{"type":"text","text":" for environments that still use unsigned metadata"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/IssueDocuments":{"role":"article","abstract":[{"type":"text","text":"The library provides the functionality to issue documents using OpenID4VCI."}],"url":"\/documentation\/eudiwalletkit\/issuedocuments","type":"topic","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/IssueDocuments","title":"Issue documents using OpenID4VCI","kind":"article"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransferMode":{"abstract":[{"type":"text","text":"Ble transfer mode"}],"title":"bleTransferMode","role":"symbol","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","kind":"symbol","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransfermode","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"bleTransferMode","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"BleTransferMode","preciseIdentifier":"s:21MdocDataTransfer1801315BleTransferModeO"}]},"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"url":"\/documentation\/eudiwalletkit\/secureareas","title":"Custom key management","role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Eudi Wallet Kit supports custom key management through the implementation of SecureArea and SecureKeyStorage protocols. This document details the process of integrating custom key management with the library."}],"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWalletConfiguration/deviceAlgorithm":{"url":"\/documentation\/eudiwalletkit\/eudiwalletconfiguration\/devicealgorithm","title":"deviceAlgorithm","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"deviceAlgorithm","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Cose","preciseIdentifier":"s:18MdocDataModel180134CoseV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"VerifyAlgorithm","preciseIdentifier":"s:18MdocDataModel180134CoseV15VerifyAlgorithmO","kind":"typeIdentifier"}],"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/deviceAlgorithm","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"COSE algorithm for mdoc device signatures. Defaults to ES256 and is ignored for device MACs."}]},"doc://EudiWalletKit/documentation/EudiWalletKit/PresentationService":{"role":"symbol","url":"\/documentation\/eudiwalletkit\/presentationservice","fragments":[{"kind":"keyword","t