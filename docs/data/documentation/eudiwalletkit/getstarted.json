{"abstract":[{"type":"text","text":"How to install and initialize EUDI Wallet Kit in your project"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/GetStarted"},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/ManageDocuments","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/RegistrationCertificate","doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/WalletUI"],"generated":true}],"metadata":{"role":"article","modules":[{"name":"EudiWalletKit"}],"roleHeading":"Article","title":"Get started"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Package-installation","type":"heading","level":2,"text":"Package installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"]},{"inlineContent":[{"type":"text","text":"Then add the Eudi Wallet package to your target’s dependencies:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"]},{"anchor":"Initialization","type":"heading","level":2,"text":"Initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","isActive":true},{"type":"text","text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an "},{"code":"environmentObject","type":"codeVoice"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"]},{"anchor":"BLE-Transfer-Mode","type":"heading","level":3,"text":"BLE Transfer Mode"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","isActive":true},{"type":"text","text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation."},{"type":"text","text":" "},{"type":"text","text":"You can set it during initialization via "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","isActive":true},{"text":" or update it later on the wallet instance:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".server"}]},{"type":"text","text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".client","type":"codeVoice"}]},{"type":"text","text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".both"}]},{"type":"text","text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement."}]}]}]},{"type":"codeListing","syntax":"swift","code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"]},{"level":3,"anchor":"BLE-Transport-Factory","text":"BLE Transport Factory","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","isActive":true,"type":"reference"},{"text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library.","type":"text"}]},{"inlineContent":[{"text":"A transport factory conforms to the ","type":"text"},{"code":"BleTransportFactory","type":"codeVoice"},{"text":" protocol and provides ","type":"text"},{"code":"createServer()","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"createClient()"},{"type":"text","text":" methods that each return an "},{"type":"codeVoice","code":"MdocBleTransport"},{"text":" instance. When ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (the default), "},{"type":"codeVoice","code":"DefaultBleTransportFactory"},{"type":"text","text":" is used, which creates the standard GATT server\/central transports."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"text":"OpenID4VCI Configuration","type":"heading","anchor":"OpenID4VCI-Configuration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}]},{"code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"issuerMetadataPolicy"},{"type":"text","text":" to control signed metadata handling per issuer:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".requireSigned","type":"codeVoice"},{"type":"text","text":" for issuers that require signed metadata validation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".ignoreSigned"},{"type":"text","text":" for environments that still use unsigned metadata"}]}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://EudiWalletKit/documentation/EudiWalletKit/SecureAreas":{"kind":"article","type":"topic","title":"Custom key management","role":"article","abstract":[{"type":"text","text":"Eudi Wallet Kit supports custom key management through the implementation of SecureArea and SecureKeyStorage protocols. This document details the process of integrating custom key management with the library."}],"url":"\/documentation\/eudiwalletkit\/secureareas","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/SecureAreas"},"doc://EudiWalletKit/documentation/EudiWalletKit/PresentationService":{"kind":"symbol","title":"PresentationService","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PresentationService"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresentationService"}],"abstract":[{"text":"Presentation service abstract protocol","type":"text"}],"url":"\/documentation\/eudiwalletkit\/presentationservice","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/PresentationService"},"doc://EudiWalletKit/documentation/EudiWalletKit/EudiWallet/bleTransportFactory":{"role":"symbol","kind":"symbol","title":"bleTransportFactory","url":"\/documentation\/eudiwalletkit\/eudiwallet\/bletransportfact