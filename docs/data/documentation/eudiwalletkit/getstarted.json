{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Article","title":"Get started","role":"article","modules":[{"name":"EudiWalletKit"}]},"hierarchy":{"paths":[["doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit"]]},"variants":[{"paths":["\/documentation\/eudiwalletkit\/getstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Package-installation","type":"heading","text":"Package installation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use EUDI Wallet Kit, add the following dependency to your Package.swift:"}]},{"syntax":"swift","code":["dependencies: [","\t\t.package(url: \"https:\/\/github.com\/eu-digital-identity-wallet\/eudi-lib-ios-wallet-kit.git\", .upToNextMajor(from: \"0.6.6\"))","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add the Eudi Wallet package to your target’s dependencies:"}]},{"syntax":"swift","code":["dependencies: [","\t\t.product(name: \"EudiWalletKit\", package: \"eudi-lib-ios-wallet-kit\"),","]"],"type":"codeListing"},{"type":"heading","text":"Initialization","level":2,"anchor":"Initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet","isActive":true,"type":"reference"},{"type":"text","text":" class provides a unified API for the two user attestation presentation flows. It is initialized with a document storage manager instance. For SwiftUI apps, the wallet instance can be added as an "},{"code":"environmentObject","type":"codeVoice"},{"text":" to be accessible from all views. A KeyChain implementation of document storage is available.","type":"text"}]},{"type":"codeListing","code":["let config = EudiWalletConfiguration(serviceName: \"my_wallet_app\", logFileName: \"temp.txt\")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.openID4VpConfig = OpenId4VpConfiguration(clientIdSchemes: [.x509SanDns, .x509Hash])","wallet.transactionLogger = MyFileTransactionLogger(wallet: wallet)","wallet.loadAllDocuments()"],"syntax":"swift"},{"type":"heading","text":"BLE Transfer Mode","level":3,"anchor":"BLE-Transfer-Mode"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransferMode","isActive":true},{"type":"text","text":" property controls the Bluetooth Low Energy role used during proximity (ISO 18013-5) presentation."},{"type":"text","text":" "},{"type":"text","text":"You can set it during initialization via "},{"type":"reference","identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWalletConfiguration\/bleTransferMode","isActive":true},{"type":"text","text":" or update it later on the wallet instance:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".server"}]},{"type":"text","text":" (default): The holder device acts as a GATT peripheral (server), advertising and waiting for the reader to connect."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".client"}],"type":"strong"},{"text":": The holder device acts as a GATT central (client), scanning and connecting to the reader’s peripheral.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".both","type":"codeVoice"}]},{"type":"text","text":": The holder device supports both modes simultaneously and advertises both in the QR device engagement."}],"type":"paragraph"}]}]},{"code":["let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server  \/\/ default; use .client or .both as needed",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)","wallet.bleTransferMode = .client"],"syntax":"swift","type":"codeListing"},{"text":"BLE Transport Factory","anchor":"BLE-Transport-Factory","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/EudiWalletKit\/documentation\/EudiWalletKit\/EudiWallet\/bleTransportFactory","isActive":true,"type":"reference"},{"type":"text","text":" property lets you plug in a custom BLE transport implementation for proximity presentation. This enables alternative BLE communication channels (e.g., L2CAP or a custom BLE client mdoc transport) without modifying the library."}],"type":"paragraph"},{"inlineContent":[{"text":"A transport factory conforms to the ","type":"text"},{"code":"BleTransportFactory","type":"codeVoice"},{"type":"text","text":" protocol and provides "},{"type":"codeVoice","code":"createServer()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"createClient()"},{"type":"text","text":" methods that each return an "},{"type":"codeVoice","code":"MdocBleTransport"},{"type":"text","text":" instance. When "},{"type":"codeVoice","code":"nil"},{"text":" (the default), ","type":"text"},{"code":"DefaultBleTransportFactory","type":"codeVoice"},{"text":" is used, which creates the standard GATT server\/central transports.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Provide a custom factory at initialization","let config = EudiWalletConfiguration(","    serviceName: \"my_wallet_app\",","    bleTransferMode: .server,","    bleTransportFactory: MyCustomTransportFactory()",")","let trustConfig = TrustConfiguration(trustSource: .etsi(.eudiRef), fallbackTrustSource: nil)","let wallet = try! EudiWallet(eudiWalletConfig: config, trustConfig: trustConfig)"]},{"type":"heading","anchor":"OpenID4VCI-Configuration","level":3,"text":"OpenID4VCI Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The wallet now supports multiple OpenID4VCI issuer configurations for enhanced flexibility. You can configure the wallet with a dictionary of issuer configurations:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Configure multiple OpenID4VCI issuers with DPoP support","let issuerConfigurations: [String: OpenId4VciConfiguration] = [","    \"eudi_pid_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/pid.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: true,","        issuerMetadataPolicy: .requireSigned(issuerTrust: issuerTrustAnchor),","        dpopKeyOptions: KeyOptions(","            secureAreaName: \"SecureEnclave\", curve: .P256, accessControl: .requireUserPresence","        )","    ),","    \"mdl_issuer\": OpenId4VciConfiguration(","        credentialIssuerURL: \"https:\/\/mdl.issuer.example.com\",","        keyAttestationsConfig: KeyAttestationConfiguration(walletAttestationsProvider: myWalletAttestationsProvider),","        requireDpop: false,","        issuerMetadataPolicy: .ignoreSigned","    )","]","","\/\/ Register additional issuers after initialization","try wallet.registerOpenId4VciServices(issuerConfigurations)"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"issuerMetadataPolicy","type":"codeVoice"},{"text":" to control signed metadata handling per issuer:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".requireSigned","type":"codeVoice"},{"text":" for issuers that require signed metadata validation","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".ignoreSigned"},{"type":"text","text":" for environments that still use unsigned metadata"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstrac